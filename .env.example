# 실제 값은 사용자가 직접 채운다. 이 파일에는 값을 적지 않는다.
# 사용법: cp .env.example .env  후 .env 에만 값을 입력

# --- LLM (기사 요약) ---
# https://console.anthropic.com 에서 발급
ANTHROPIC_API_KEY=

# --- Supabase (기사 영구 저장) ---
# 프로젝트 설정 > API 에서 확인
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# --- Telegram (알림 발송) ---
# @BotFather 에서 봇 생성 후 발급
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Naver 검색 API (선택, 수집 소스 보강) ---
# https://developers.naver.com 에서 발급
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# --- 운영 설정 (값이 없으면 기본값 사용) ---
POLL_INTERVAL_SEC=60          # 폴링 주기 (30~300)
FRESH_CUTOFF_HOURS=6          # 이 시간 이내면 알림 대상
BACKFILL_CUTOFF_HOURS=72      # 이 시간 초과면 저장하지 않음
NOTIFY_THRESHOLD=50           # 알림 중요도 임계값 (0~100)
LLM_DAILY_LIMIT=500           # 일일 LLM 호출 상한
