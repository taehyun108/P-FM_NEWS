# 실제 값은 사용자가 직접 채운다. 이 파일에는 값을 적지 않는다.
# 사용법: cp .env.example .env  후 .env 에만 값을 입력

# --- LLM (기사 요약) ---
# https://platform.openai.com/api-keys 에서 발급
OPENAI_API_KEY=

# 모델 지정 (모델명은 비밀값이 아니므로 그대로 적는다)
LLM_MODEL=gpt-5.6-luna                    # 기사 요약 · 분류 보조 · SWOT 분석
EMBEDDING_MODEL=text-embedding-3-small    # 중복 판정(F2.2) 의미 유사도

# --- 대체 공급자 (선택) — OpenAI 호출이 실패할 때만 자동으로 넘어간다 ---
# https://build.nvidia.com 에서 발급. 비워두면 대체 없이 기존처럼 동작
NVIDIA_EMBED_API_KEY=
NVIDIA_EMBED_MODEL=nemotron-3-embed-1b   # 임베딩 대체(4단계 중복판정용)
NVIDIA_LLM_API_KEY=
NVIDIA_LLM_MODEL=meta/llama-3.2-90b-vision-instruct   # 분석·요약·주간레포트·챗봇 대체

# --- DB 백엔드 선택 ---
# sqlite: 로컬 개발용 (키 불필요) / supabase: 운영용
# Supabase 키 3개를 채운 뒤 이 값만 supabase 로 바꾸면 전환된다.
DB_BACKEND=sqlite
SQLITE_PATH=backend/pfm_news.db

# --- Supabase (기사 영구 저장) ---
# 프로젝트 설정 > API 에서 확인. service_role 키는 RLS 를 우회하므로 서버에서만 쓴다.
# 두 키를 서로 바꿔 넣어도 코드가 JWT role 로 service_role 키를 골라 쓴다.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# --- Telegram (알림 발송) ---
# @BotFather 에서 봇 생성 후 발급
TELEGRAM_BOT_TOKEN=
# 알림을 받을 대화방. 봇에게 메시지를 한 번 보낸 뒤 `python backend/main.py chatid` 로 확인.
#   개인 DM = 양수 숫자 / 그룹·채널 = 음수(-100…) / 공개 채널 = @채널이름
TELEGRAM_CHAT_ID=
# (선택) 웹 헤더 'Telegram' 버튼이 여는 주소. 채널 초대 링크를 넣으면 구독 유도.
# 비우면 봇 1:1 대화방으로 연결된다.
TELEGRAM_CHANNEL_URL=

# --- 카카오톡 '나에게 보내기' (선택 · 기본 비활성 — 텔레그램만 사용) ---
# text 템플릿 200자 한도로 텔레그램(4096자) 대비 정보량이 적어 기본은 꺼 둔다.
# 코드·라우트·selftest 는 그대로 있고, 아래 KAKAO_ENABLED=true 로만 켜진다.
#   1) KAKAO_ENABLED=true
#   2) developers.kakao.com > 내 앱 > 앱 > 플랫폼 키 에서 REST API 키·Client Secret
#   3) REDIRECT_URI 를 카카오 콘솔 '카카오 로그인 > Redirect URI' 에 똑같이 등록
#      로컬 http://localhost:8000/kakao/callback  /  배포 https://<배포주소>/kakao/callback
#   4) 서버를 켠 상태로 `python backend/main.py kakao-auth` 가 출력하는 URL 1회 방문
KAKAO_ENABLED=false
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:8000/kakao/callback

# --- NAVER 검색 API (선택, 수집 소스 보강) ---
# NAVER Cloud Platform > NAVER API HUB > Application 등록 (사용 API: NAVER 검색 - 뉴스)
# console 의 [인증 정보] 버튼에서 Client ID / Client Secret 확인
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_INTERVAL_SEC=300        # 네이버 조회 간격(초). 하루 25,000회 한도 대응 (최소 60)

# --- 운영 설정 (값이 없으면 기본값 사용) ---
POLL_INTERVAL_SEC=300        # 수집 주기(초). 네이버 호출도 300초 주기라 그보다 짧게 둘 이유 없음
FRESH_CUTOFF_HOURS=6          # 이 시간 이내면 알림 대상
BACKFILL_CUTOFF_HOURS=72      # 이 시간 초과면 저장하지 않음
NOTIFY_THRESHOLD=50           # 알림 중요도 임계값 (0~100)
LLM_DAILY_LIMIT=1500          # 일일 LLM 분석 상한 (하루 수집량 + 재분석 여유)
LLM_PER_RUN=20                # 1회 실행당 분석 건수 (나머지는 다음 실행·메타 저장으로 처리)
ARTICLE_RETENTION_DAYS=550    # 핵심 기사 보존일(≈18개월). 알림대상·고중요도·그룹사 태그 기사 기준.
                             #   그 외 잡음 기사는 90일, 수집로그 90일, URL원장 180일 후 자동 삭제.
                             #   Supabase 무료 500MB 한도 대비 — 늘리면 용량도 비례해 커진다.

# --- 마스터 패널 ---
# 웹 우측 상단 '마스터' 버튼의 초기 비밀번호. 패널에서 변경하면 DB 해시가 우선한다.
MASTER_PASSWORD=

# --- 배포 (로컬 개발이면 전부 비워 둬도 된다) ---
# 사이트 전체 잠금. 값이 있으면 접속 시 비밀번호를 묻고, 통과해야 화면·API 를 준다.
#   비우면 잠금이 꺼진다(로컬 개발). 배포할 때는 반드시 채운다.
#   마스터 패널에서 '웹페이지 비밀번호'를 바꾸면 그 값이 우선한다.
WEB_PASSWORD=
# 운영 기준 시간대의 UTC 오프셋. 야간 억제·주간 레포트 발송 시각·
# 대외협력 수집 시각(9·15시)이 모두 이 값을 기준으로 판단된다.
#   클라우드 서버는 대부분 UTC 라 이 값이 없으면 9시간 어긋난다. 한국 = 9.
APP_TZ_OFFSET=9
# 야간 억제 창 — 위 APP_TZ_OFFSET 기준 시각(0~23). 이 시간대엔 중요도 NIGHT_MIN_SCORE
# 이상(또는 항상발송키워드·무조건점수)만 즉시 발송하고 나머지는 아침에 나간다.
NIGHT_START_HOUR=23
NIGHT_END_HOUR=7
NIGHT_MIN_SCORE=80          # 101 로 두면 우선 기사만 나가고 사실상 야간 전면 차단
# 리슨 주소. 컨테이너·클라우드는 0.0.0.0 이어야 밖에서 붙는다.
#   PORT 환경변수가 주입돼 있으면(클라우드) 자동으로 0.0.0.0 이 기본값이 된다.
API_HOST=127.0.0.1
API_PORT=8000
# 교차 오리진 허용 목록(콤마 구분). 프런트를 같은 주소에서 서빙하므로 보통 비운다.
#   비우면 다른 사이트에서 이 API 를 호출할 수 없다(권장).
ALLOWED_ORIGINS=

# --- LangSmith (LLM 호출 추적·관측, 선택) ---
# https://smith.langchain.com > Settings > API Keys 에서 발급.
# 값이 채워지고 langsmith 패키지가 설치돼 있을 때만 트레이싱이 켜진다.
LANGSMITH_TRACING=            # true 로 설정하면 추적 on (비우면 off)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=P-FM_NEWS   # 대시보드에 표시될 프로젝트 이름
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# --- 주간 레포트 이메일 (월요일 아침, Gmail SMTP) ---
# Gmail 2단계 인증 후 "앱 비밀번호"(16자리) 발급: https://myaccount.google.com/apppasswords
# SMTP_USER · SMTP_APP_PASSWORD 가 비어 있으면 레포트는 생성·저장만 하고 발송은 건너뛴다.
WEEKLY_REPORT_ENABLED=       # true 면 월요일 아침 자동 생성·발송
WEEKLY_REPORT_TO=            # 수신자 이메일 (쉼표로 여러 명)
WEEKLY_REPORT_HOUR=7         # 월요일 발송 시각 (0~23, 서버 로컬시간)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=                   # 발신 Gmail 주소
SMTP_APP_PASSWORD=           # Gmail 앱 비밀번호 16자리

# --- 대외협력(대관) 탭 — 입법·행정예고 · 국회 의안 ---
# 하루 2회(기본 09시·15시) 별도 스레드가 수집한다. 기존 300초 수집 루프와 무관.
EA_ENABLED=true
EA_SCHEDULE_HOURS=9,15        # 수집 시각(서버 로컬시간, 쉼표 구분)
EA_LLM_DAILY_LIMIT=50         # 대외협력 전용 일일 LLM 상한 (뉴스 예산 잠식 방지)
EA_ASSEMBLY_AGE=22            # 국회 대수

# ── 인증키는 모두 선택 ──────────────────────────────────────────────
# 키가 하나도 없으면 크롤링으로 동작한다(opinion.lawmaking.go.kr · pal.assembly.go.kr,
# robots.txt Allow:/ · 공공누리 자료 · 요청 간 1초). 키를 넣으면 해당 소스만 REST 로 바뀐다.
#
# 국민참여입법센터 OC — opinion.lawmaking.go.kr 정보공개 서비스 신청 ID (입법·행정예고 REST)
EA_LAWMAKING_OC=
# 열린국회정보 인증키 — open.assembly.go.kr 회원가입 후 즉시 발급 (국회 의안 REST)
EA_ASSEMBLY_KEY=
# KOTRA 해외시장뉴스 — data.go.kr/15034831 "대한무역투자진흥공사_해외시장뉴스" 활용신청 후 발급받은
# 일반 인증키(Encoding). 비우면 '통상 환경' 탭의 KOTRA 항목만 꺼진다(다른 소스는 그대로).
EA_KOTRA_SERVICE_KEY=
# (선택) 엔드포인트 오버라이드. 비우면 코드 기본값 사용
#   https://apis.data.go.kr/B410001/kotra_overseasMarketNews/ovseaMrktNews/ovseaMrktNews
EA_KOTRA_API_URL=
