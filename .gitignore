# 환경변수 (키 값은 절대 커밋하지 않는다)
.env
.env.*
!.env.example

# 파이썬
__pycache__/
*.py[cod]
.venv/
venv/

# 로컬 DB (개발용 SQLite — 기사 원문이 담기므로 커밋하지 않는다)
*.db
*.db-wal
*.db-shm

# 기타
.DS_Store
# Office 임시 잠금 파일
~$*

# 발표자료 — 공식 템플릿(18MB)을 베이스로 생성되므로 결과물은 커밋하지 않는다.
# docs/make_decks.py 로 언제든 다시 만든다: python docs/make_decks.py <템플릿.pptx>
docs/P-FM_NEWS_실무자_발표_10분.pptx
docs/P-FM_NEWS_임원_발표_10분.pptx

# demo-video 스킬 — npm 의존성과 결과 영상은 커밋하지 않는다.
# bash .claude/skills/demo-video/scripts/setup.sh 로 언제든 다시 설치한다.
.claude/skills/demo-video/node_modules/
.claude/skills/demo-video/out/
